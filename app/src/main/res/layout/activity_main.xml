<?xml version="1.0" encoding="utf-8"?>
<!--
  v4 三页结构：
  ① 守护页 = 深色仪式舞台（巨型主开关 + 每日一句）+ 提醒方式开关
  ② 提醒页 = 悬浮条外观编辑与实时预览
  ③ 调校页 = 常用 / 专家滑杆
  底部固定三 tab。三页用 visibility 切换，不引入 Fragment / 第三方依赖。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:orientation="vertical">

    <!-- 三页共处一层，代码只切换可见性 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ========== 第 1 页：守护 ========== -->
        <ScrollView
            android:id="@+id/page_guard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 仪式舞台：左对齐、深底暖字，与下方暖白工具区形成强对比 -->
                <LinearLayout
                    android:id="@+id/stage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/stage_bg"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_5"
                    android:paddingTop="@dimen/space_6"
                    android:paddingEnd="@dimen/space_5"
                    android:paddingBottom="@dimen/space_6">

                    <TextView
                        android:id="@+id/tv_brand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.16"
                        android:text="@string/ritual_eyebrow"
                        android:textColor="@color/stage_sub"
                        android:textSize="@dimen/text_micro" />

                    <!-- 巨型开关：四层叠加，点击区 228dp 远超 44dp 触摸目标 -->
                    <FrameLayout
                        android:id="@+id/hero_switch"
                        android:layout_width="@dimen/hero_halo"
                        android:layout_height="@dimen/hero_halo"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/space_4"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/ritual_title">

                        <View
                            android:id="@+id/hero_halo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:background="@drawable/ritual_halo" />

                        <View
                            android:id="@+id/hero_ring"
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            android:layout_gravity="center"
                            android:background="@drawable/ritual_ring" />

                        <View
                            android:id="@+id/hero_core"
                            android:layout_width="@dimen/hero_switch"
                            android:layout_height="@dimen/hero_switch"
                            android:layout_gravity="center"
                            android:background="@drawable/ritual_core_on" />

                        <ImageView
                            android:id="@+id/hero_mark"
                            android:layout_width="@dimen/hero_icon"
                            android:layout_height="@dimen/hero_icon"
                            android:layout_gravity="center"
                            android:contentDescription="@string/ritual_title"
                            android:src="@drawable/ic_ritual_mark" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_ritual_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/space_2"
                        android:includeFontPadding="false"
                        android:text="@string/ritual_state_on"
                        android:textColor="@color/stage_text"
                        android:textSize="@dimen/text_ritual"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_mantra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/space_1"
                        android:gravity="center_horizontal"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/mantra_rest"
                        android:textColor="@color/stage_sub"
                        android:textSize="@dimen/text_mantra" />

                    <TextView
                        android:id="@+id/tv_ritual_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="@string/ritual_hint_off"
                        android:textColor="@color/stage_accent"
                        android:textSize="@dimen/text_caption" />

                    <!-- 实时倾角：暖橘大数字压在舞台底部，是第二视觉中心 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_5"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_monitor"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="○ 未监测"
                            android:textColor="@color/stage_sub"
                            android:textSize="@dimen/text_caption" />

                        <TextView
                            android:id="@+id/tv_angle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:text="--°"
                            android:textColor="@color/stage_accent"
                            android:textSize="@dimen/text_hero"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_angle_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_2"
                            android:text="当前倾角"
                            android:textColor="@color/stage_sub"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 权限提示条：逻辑与 v2 完全一致 -->
                <LinearLayout
                    android:id="@+id/tip_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_5"
                    android:layout_marginTop="@dimen/space_4"
                    android:layout_marginEnd="@dimen/space_5"
                    android:background="@color/tip_bg"
                    android:clickable="true"
                    android:orientation="vertical"
                    android:padding="@dimen/space_3">

                    <TextView
                        android:id="@+id/tip_head"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:minHeight="@dimen/min_touch"
                        android:paddingStart="@dimen/space_1"
                        android:paddingEnd="@dimen/space_1"
                        android:text="@string/tip_collapsed"
                        android:textColor="@color/text_main"
                        android:textSize="@dimen/text_caption" />

                    <LinearLayout
                        android:id="@+id/tip_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tip_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/main_notice"
                            android:textColor="@color/text_main"
                            android:textSize="@dimen/text_caption" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/tip_dismiss"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?android:attr/selectableItemBackground"
                                android:text="@string/main_notice_dismiss"
                                android:textColor="@color/text_sub"
                                android:textSize="@dimen/text_caption" />

                            <Button
                                android:id="@+id/tip_go"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?android:attr/selectableItemBackground"
                                android:text="@string/main_notice_go"
                                android:textColor="@color/brand"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_5"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="服务未连接"
                    android:textColor="@color/text_main"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_guide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_5"
                    android:layout_marginTop="@dimen/space_2"
                    android:layout_marginEnd="@dimen/space_5"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="权限自检 / 设置向导"
                    android:textColor="@color/brand"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/tv_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_5"
                    android:layout_marginTop="@dimen/space_2"
                    android:layout_marginEnd="@dimen/space_5"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/main_hint"
                    android:textColor="@color/text_sub"
                    android:textSize="@dimen/text_caption" />

                <!-- 守护页设置组：状态 / 提醒方式 / 监测范围 -->
                <LinearLayout
                    android:id="@+id/settings_guard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_5"
                    android:layout_marginTop="@dimen/space_3"
                    android:layout_marginEnd="@dimen/space_5"
                    android:layout_marginBottom="@dimen/space_7"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- ========== 第 2 页：提醒（悬浮条外观） ========== -->
        <ScrollView
            android:id="@+id/page_remind"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_5"
                android:paddingTop="@dimen/space_6"
                android:paddingEnd="@dimen/space_5"
                android:paddingBottom="@dimen/space_7">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="提醒的样子"
                    android:textColor="@color/text_sub"
                    android:textSize="@dimen/text_micro"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="把提醒调成你愿意看见的样子"
                    android:textColor="@color/text_main"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/settings_remind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- ========== 第 3 页：调校（常用 / 专家） ========== -->
        <ScrollView
            android:id="@+id/page_tune"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_5"
                android:paddingTop="@dimen/space_6"
                android:paddingEnd="@dimen/space_5"
                android:paddingBottom="@dimen/space_7">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="调校"
                    android:textColor="@color/text_sub"
                    android:textSize="@dimen/text_micro"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="松手就生效，不确定就别动"
                    android:textColor="@color/text_main"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/settings_tune"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- 底部导航：三等分、发丝分隔线、图标 + 文字双态 -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_height"
        android:background="@drawable/nav_bg_line"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tab_guard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tab_icon_guard"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/tab_guard"
                android:src="@drawable/ic_tab_guard" />

            <TextView
                android:id="@+id/tab_label_guard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_guard"
                android:textColor="@drawable/tab_text_color"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_remind"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tab_icon_remind"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/tab_remind"
                android:src="@drawable/ic_tab_remind" />

            <TextView
                android:id="@+id/tab_label_remind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_remind"
                android:textColor="@drawable/tab_text_color"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_tune"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tab_icon_tune"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/tab_tune"
                android:src="@drawable/ic_tab_tune" />

            <TextView
                android:id="@+id/tab_label_tune"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_tune"
                android:textColor="@drawable/tab_text_color"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
